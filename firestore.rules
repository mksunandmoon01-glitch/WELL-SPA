rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isPrimaryAdmin() {
      return isVerified() && request.auth.token.email == 'mk.sunandmoon01@gmail.com';
    }

    function authEmailDocId() {
      return request.auth.token.email.lower().replace('@', '_at_').replace('\\.', '_dot_').replace('\\+', '_plus_');
    }

    function isAuthorizedAccount() {
      return isPrimaryAdmin() || (
        isVerified() && (
          (exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.active == true) ||
          (exists(/databases/$(database)/documents/staffAccess/$(authEmailDocId())) &&
           get(/databases/$(database)/documents/staffAccess/$(authEmailDocId())).data.active == true)
        )
      );
    }

    function isValidMemberUids(uids) {
      return uids is list &&
        uids.size() >= 1 &&
        uids.size() <= 25 &&
        uids[0] is string &&
        uids[0].size() >= 1 &&
        uids[0].size() <= 128;
    }

    function isValidMemberEmails(emails) {
      return emails is list &&
        emails.size() <= 25 &&
        (emails.size() == 0 || (emails[0] is string && emails[0].size() >= 3 && emails[0].size() <= 160));
    }

    function hasStudioDocAccess(data) {
      return isPrimaryAdmin() || (
        isVerified() && (
          request.auth.uid in data.memberUids ||
          ('memberEmails' in data && request.auth.token.email.lower() in data.memberEmails)
        )
      );
    }

    function hasStudioAccess(studioId) {
      return isPrimaryAdmin() || (
        isVerified() &&
        exists(/databases/$(database)/documents/studios/$(studioId)) &&
        (
          request.auth.uid in get(/databases/$(database)/documents/studios/$(studioId)).data.memberUids ||
          ('memberEmails' in get(/databases/$(database)/documents/studios/$(studioId)).data &&
           request.auth.token.email.lower() in get(/databases/$(database)/documents/studios/$(studioId)).data.memberEmails)
        )
      );
    }

    function isValidPermissionsMap(perms) {
      return perms is map &&
        perms.keys().hasAll([
          'appointments', 'staff', 'memberships', 'notifications', 'services', 'reports', 'booking_portal', 'users'
        ]) &&
        perms.keys().hasOnly([
          'appointments', 'staff', 'memberships', 'notifications', 'services', 'reports', 'booking_portal', 'users'
        ]) &&
        perms.appointments is bool &&
        perms.staff is bool &&
        perms.memberships is bool &&
        perms.notifications is bool &&
        perms.services is bool &&
        perms.reports is bool &&
        perms.booking_portal is bool &&
        perms.users is bool;
    }

    function isValidStudio(data) {
      return data.keys().hasAll([
          'ownerId', 'memberUids', 'name', 'tagline', 'timezone', 'currency', 'address', 'phone', 'seeded', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'memberUids', 'memberEmails', 'name', 'venueName', 'tagline', 'timezone', 'currency', 'address', 'phone',
          'contactEmail', 'telegramContacts', 'telegramChannel', 'seeded', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidMemberUids(data.memberUids) &&
        (!('memberEmails' in data) || isValidMemberEmails(data.memberEmails)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('venueName' in data) || (data.venueName is string && data.venueName.size() <= 160)) &&
        data.tagline is string && data.tagline.size() <= 200 &&
        data.timezone is string && data.timezone.size() >= 1 && data.timezone.size() <= 64 &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 8 &&
        data.address is string && data.address.size() <= 240 &&
        data.phone is string && data.phone.size() <= 64 &&
        (!('contactEmail' in data) || (data.contactEmail is string && data.contactEmail.size() <= 160)) &&
        (!('telegramContacts' in data) || (data.telegramContacts is string && data.telegramContacts.size() <= 160)) &&
        (!('telegramChannel' in data) || (data.telegramChannel is string && data.telegramChannel.size() <= 160)) &&
        data.seeded is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRoom(data) {
      return data.keys().hasAll([
          'ownerId', 'memberUids', 'name', 'roomType', 'active', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'memberUids', 'memberEmails', 'name', 'roomType', 'active', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidMemberUids(data.memberUids) &&
        (!('memberEmails' in data) || isValidMemberEmails(data.memberEmails)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.roomType is string && data.roomType.size() >= 1 && data.roomType.size() <= 80 &&
        data.active is bool &&
        data.notes is string && data.notes.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidService(data) {
      return data.keys().hasAll([
          'ownerId', 'memberUids', 'name', 'category', 'durationMinutes', 'bufferMinutes', 'price', 'roomType', 'description', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'memberUids', 'memberEmails', 'name', 'category', 'durationMinutes', 'bufferMinutes', 'price', 'roomType', 'description', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidMemberUids(data.memberUids) &&
        (!('memberEmails' in data) || isValidMemberEmails(data.memberEmails)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.category in ['Massage', 'Facial', 'Body Ritual', 'Hydrotherapy', 'Add-On'] &&
        data.durationMinutes is number && data.durationMinutes >= 5 && data.durationMinutes <= 480 &&
        data.bufferMinutes is number && data.bufferMinutes >= 0 && data.bufferMinutes <= 60 &&
        data.price is number && data.price >= 0 && data.price <= 50000 &&
        data.roomType is string && data.roomType.size() >= 1 && data.roomType.size() <= 80 &&
        data.description is string && data.description.size() <= 500 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaff(data) {
      return data.keys().hasAll([
          'ownerId', 'memberUids', 'name', 'role', 'specialty', 'bio', 'avatarUrl', 'assignedRoom',
          'onDuty', 'workDays', 'shiftStart', 'shiftEnd', 'breakStart', 'breakEnd', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'memberUids', 'memberEmails', 'name', 'role', 'specialty', 'bio', 'avatarUrl', 'assignedRoomId', 'assignedRoom',
          'onDuty', 'workDays', 'shiftStart', 'shiftEnd', 'breakStart', 'breakEnd', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidMemberUids(data.memberUids) &&
        (!('memberEmails' in data) || isValidMemberEmails(data.memberEmails)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 80 &&
        data.specialty is string && data.specialty.size() <= 160 &&
        data.bio is string && data.bio.size() <= 400 &&
        data.avatarUrl is string && data.avatarUrl.size() <= 250000 &&
        (!('assignedRoomId' in data) || (data.assignedRoomId is string && data.assignedRoomId.size() <= 128)) &&
        data.assignedRoom is string && data.assignedRoom.size() >= 1 && data.assignedRoom.size() <= 80 &&
        data.onDuty is bool &&
        data.workDays is list && data.workDays.size() <= 7 && (data.workDays.size() == 0 || data.workDays[0] is string) &&
        data.shiftStart is string && data.shiftStart.size() >= 4 && data.shiftStart.size() <= 10 &&
        data.shiftEnd is string && data.shiftEnd.size() >= 4 && data.shiftEnd.size() <= 10 &&
        data.breakStart is string && data.breakStart.size() <= 10 &&
        data.breakEnd is string && data.breakEnd.size() <= 10 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMembershipTier(data) {
      return data.keys().hasAll([
          'ownerId', 'memberUids', 'name', 'targetAudience', 'monthlyPrice', 'creditsPerMonth',
          'retailDiscountPercent', 'priorityWindowHours', 'perksSummary', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'memberUids', 'memberEmails', 'name', 'targetAudience', 'monthlyPrice', 'creditsPerMonth',
          'retailDiscountPercent', 'priorityWindowHours', 'perksSummary', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidMemberUids(data.memberUids) &&
        (!('memberEmails' in data) || isValidMemberEmails(data.memberEmails)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.targetAudience is string && data.targetAudience.size() <= 120 &&
        data.monthlyPrice is number && data.monthlyPrice >= 0 && data.monthlyPrice <= 50000 &&
        data.creditsPerMonth is number && data.creditsPerMonth >= 0 && data.creditsPerMonth <= 50000 &&
        data.retailDiscountPercent is number && data.retailDiscountPercent >= 0 && data.retailDiscountPercent <= 100 &&
        data.priorityWindowHours is number && data.priorityWindowHours >= 0 && data.priorityWindowHours <= 720 &&
        data.perksSummary is string && data.perksSummary.size() <= 400 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidClient(data) {
      return data.keys().hasAll([
          'ownerId', 'memberUids', 'fullName', 'email', 'phone', 'notes', 'preferredTherapistId',
          'membershipTierId', 'membershipTierName', 'membershipStatus', 'creditsRemaining',
          'nextRenewalDate', 'totalVisits', 'lifetimeSpend', 'smsOptIn', 'emailOptIn', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'memberUids', 'memberEmails', 'fullName', 'email', 'phone', 'notes', 'preferredTherapistId',
          'membershipTierId', 'membershipTierName', 'membershipStatus', 'creditsRemaining',
          'nextRenewalDate', 'totalVisits', 'lifetimeSpend', 'smsOptIn', 'emailOptIn', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidMemberUids(data.memberUids) &&
        (!('memberEmails' in data) || isValidMemberEmails(data.memberEmails)) &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.email is string && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() <= 32 &&
        data.notes is string && data.notes.size() <= 500 &&
        data.preferredTherapistId is string && data.preferredTherapistId.size() <= 128 &&
        data.membershipTierId is string && data.membershipTierId.size() <= 128 &&
        data.membershipTierName is string && data.membershipTierName.size() <= 100 &&
        data.membershipStatus in ['none', 'active', 'paused', 'cancelled'] &&
        data.creditsRemaining is number && data.creditsRemaining >= 0 && data.creditsRemaining <= 100000 &&
        data.nextRenewalDate is string && data.nextRenewalDate.size() <= 20 &&
        data.totalVisits is number && data.totalVisits >= 0 && data.totalVisits <= 100000 &&
        data.lifetimeSpend is number && data.lifetimeSpend >= 0 && data.lifetimeSpend <= 10000000 &&
        data.smsOptIn is bool &&
        data.emailOptIn is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
          'ownerId', 'memberUids', 'clientId', 'clientName', 'clientEmail', 'clientPhone',
          'serviceId', 'serviceName', 'staffId', 'staffName', 'roomName',
          'date', 'startTime', 'durationMinutes', 'price', 'usedMembershipCredit',
          'status', 'notes', 'confirmationSent', 'reminderSent', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'memberUids', 'memberEmails', 'clientId', 'clientName', 'clientEmail', 'clientPhone',
          'serviceId', 'serviceName', 'staffId', 'staffName', 'roomName',
          'date', 'startTime', 'durationMinutes', 'price', 'usedMembershipCredit', 'creditsUsed', 'amountPaid',
          'status', 'notes', 'confirmationSent', 'reminderSent', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidMemberUids(data.memberUids) &&
        (!('memberEmails' in data) || isValidMemberEmails(data.memberEmails)) &&
        data.clientId is string && data.clientId.size() <= 128 &&
        data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120 &&
        data.clientEmail is string && data.clientEmail.size() <= 160 &&
        data.clientPhone is string && data.clientPhone.size() <= 32 &&
        data.serviceId is string && data.serviceId.size() >= 1 && data.serviceId.size() <= 128 &&
        data.serviceName is string && data.serviceName.size() >= 1 && data.serviceName.size() <= 120 &&
        data.staffId is string && data.staffId.size() >= 1 && data.staffId.size() <= 128 &&
        data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 120 &&
        data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 80 &&
        data.date is string && data.date.size() == 10 &&
        data.startTime is string && data.startTime.size() >= 4 && data.startTime.size() <= 8 &&
        data.durationMinutes is number && data.durationMinutes >= 5 && data.durationMinutes <= 480 &&
        data.price is number && data.price >= 0 && data.price <= 50000 &&
        data.usedMembershipCredit is bool &&
        (!('creditsUsed' in data) || (data.creditsUsed is number && data.creditsUsed >= 0 && data.creditsUsed <= 50000)) &&
        (!('amountPaid' in data) || (data.amountPaid is number && data.amountPaid >= 0 && data.amountPaid <= 50000)) &&
        data.status in ['confirmed', 'checked_in', 'in_progress', 'completed', 'cancelled', 'no_show'] &&
        data.notes is string && data.notes.size() <= 500 &&
        data.confirmationSent is bool &&
        data.reminderSent is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotificationRule(data) {
      return data.keys().hasAll([
          'ownerId', 'memberUids', 'eventKey', 'title', 'channel', 'timingLabel', 'enabled',
          'subjectTemplate', 'bodyTemplate', 'sentCount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'memberUids', 'memberEmails', 'eventKey', 'title', 'channel', 'timingLabel', 'enabled',
          'subjectTemplate', 'bodyTemplate', 'sentCount', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidMemberUids(data.memberUids) &&
        (!('memberEmails' in data) || isValidMemberEmails(data.memberEmails)) &&
        data.eventKey in ['booking_confirmed', 'reminder_24h', 'checkin_2h', 'post_visit_rebook', 'membership_renewed'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.channel in ['Email + SMS', 'SMS', 'Email'] &&
        data.timingLabel is string && data.timingLabel.size() >= 1 && data.timingLabel.size() <= 80 &&
        data.enabled is bool &&
        data.subjectTemplate is string && data.subjectTemplate.size() <= 200 &&
        data.bodyTemplate is string && data.bodyTemplate.size() <= 800 &&
        data.sentCount is number && data.sentCount >= 0 && data.sentCount <= 1000000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotificationLog(data) {
      return data.keys().hasAll([
          'ownerId', 'memberUids', 'ruleId', 'eventKey', 'appointmentId', 'clientId', 'clientName',
          'recipientContact', 'channel', 'subject', 'messageBody', 'status', 'scheduledFor',
          'sentAtLabel', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'memberUids', 'memberEmails', 'ruleId', 'eventKey', 'appointmentId', 'clientId', 'clientName',
          'recipientContact', 'channel', 'subject', 'messageBody', 'status', 'scheduledFor',
          'sentAtLabel', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidMemberUids(data.memberUids) &&
        (!('memberEmails' in data) || isValidMemberEmails(data.memberEmails)) &&
        data.ruleId is string && data.ruleId.size() <= 128 &&
        data.eventKey is string && data.eventKey.size() <= 64 &&
        data.appointmentId is string && data.appointmentId.size() <= 128 &&
        data.clientId is string && data.clientId.size() <= 128 &&
        data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120 &&
        data.recipientContact is string && data.recipientContact.size() <= 160 &&
        data.channel in ['SMS', 'Email'] &&
        data.subject is string && data.subject.size() <= 200 &&
        data.messageBody is string && data.messageBody.size() <= 900 &&
        data.status in ['sent', 'scheduled', 'failed'] &&
        data.scheduledFor is string && data.scheduledFor.size() <= 80 &&
        data.sentAtLabel is string && data.sentAtLabel.size() <= 80 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCreditDeduction(data) {
      return data.keys().hasAll([
          'ownerId', 'memberUids', 'clientId', 'clientName', 'category', 'description',
          'creditsDeducted', 'recordedByEmail', 'date', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'memberUids', 'memberEmails', 'clientId', 'clientName', 'category', 'description',
          'creditsDeducted', 'recordedByEmail', 'date', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        isValidMemberUids(data.memberUids) &&
        (!('memberEmails' in data) || isValidMemberEmails(data.memberEmails)) &&
        data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 &&
        data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 120 &&
        data.category in ['Massage', 'Order Item', 'Service'] &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 300 &&
        data.creditsDeducted is number && data.creditsDeducted >= 1 && data.creditsDeducted <= 50000 &&
        data.recordedByEmail is string && data.recordedByEmail.size() <= 160 &&
        data.date is string && data.date.size() >= 4 && data.date.size() <= 20 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAuthorizedUser(data) {
      return data.keys().hasAll([
          'uid', 'email', 'fullName', 'role', 'active', 'createdByUid', 'createdByEmail', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'email', 'fullName', 'role', 'active', 'createdByUid', 'createdByEmail', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.role in ['admin', 'manager', 'staff'] &&
        data.active is bool &&
        isValidId(data.createdByUid) &&
        data.createdByUid == request.auth.uid &&
        data.createdByEmail is string && data.createdByEmail.size() >= 3 && data.createdByEmail.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffAccess(data) {
      return data.keys().hasAll([
          'ownerId', 'email', 'fullName', 'role', 'isPrimaryAdmin', 'active', 'permissions', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'email', 'fullName', 'role', 'isPrimaryAdmin', 'active', 'permissions', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.role in ['admin', 'manager', 'staff'] &&
        data.isPrimaryAdmin is bool &&
        data.active is bool &&
        isValidPermissionsMap(data.permissions) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPublicStudio(data) {
      return data.keys().hasAll(['name', 'venueName', 'tagline', 'timezone', 'currency', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'venueName', 'tagline', 'timezone', 'currency', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.venueName is string && data.venueName.size() <= 160 &&
        data.tagline is string && data.tagline.size() <= 200 &&
        data.timezone is string && data.timezone.size() >= 1 && data.timezone.size() <= 64 &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 8 &&
        data.updatedAt is timestamp;
    }

    function isValidPublicService(data) {
      return data.keys().hasAll([
          'name', 'category', 'durationMinutes', 'bufferMinutes', 'price', 'roomType', 'description', 'active', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'category', 'durationMinutes', 'bufferMinutes', 'price', 'roomType', 'description', 'active', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.category in ['Massage', 'Facial', 'Body Ritual', 'Hydrotherapy', 'Add-On'] &&
        data.durationMinutes is number && data.durationMinutes >= 5 && data.durationMinutes <= 480 &&
        data.bufferMinutes is number && data.bufferMinutes >= 0 && data.bufferMinutes <= 60 &&
        data.price is number && data.price >= 0 && data.price <= 50000 &&
        data.roomType is string && data.roomType.size() >= 1 && data.roomType.size() <= 80 &&
        data.description is string && data.description.size() <= 500 &&
        data.active is bool &&
        data.updatedAt is timestamp;
    }

    function isValidPublicRoom(data) {
      return data.keys().hasAll(['name', 'roomType', 'active', 'notes', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'roomType', 'active', 'notes', 'updatedAt']) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.roomType is string && data.roomType.size() >= 1 && data.roomType.size() <= 80 &&
        data.active is bool &&
        data.notes is string && data.notes.size() <= 500 &&
        data.updatedAt is timestamp;
    }

    function isValidPublicStaff(data) {
      return data.keys().hasAll([
          'name', 'role', 'specialty', 'bio', 'avatarUrl', 'assignedRoom',
          'onDuty', 'workDays', 'shiftStart', 'shiftEnd', 'breakStart', 'breakEnd', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'name', 'role', 'specialty', 'bio', 'avatarUrl', 'assignedRoomId', 'assignedRoom',
          'onDuty', 'workDays', 'shiftStart', 'shiftEnd', 'breakStart', 'breakEnd', 'updatedAt'
        ]) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 80 &&
        data.specialty is string && data.specialty.size() <= 160 &&
        data.bio is string && data.bio.size() <= 400 &&
        data.avatarUrl is string && data.avatarUrl.size() <= 250000 &&
        (!('assignedRoomId' in data) || (data.assignedRoomId is string && data.assignedRoomId.size() <= 128)) &&
        data.assignedRoom is string && data.assignedRoom.size() >= 1 && data.assignedRoom.size() <= 80 &&
        data.onDuty is bool &&
        data.workDays is list && data.workDays.size() <= 7 && (data.workDays.size() == 0 || data.workDays[0] is string) &&
        data.shiftStart is string && data.shiftStart.size() >= 4 && data.shiftStart.size() <= 10 &&
        data.shiftEnd is string && data.shiftEnd.size() >= 4 && data.shiftEnd.size() <= 10 &&
        data.breakStart is string && data.breakStart.size() <= 10 &&
        data.breakEnd is string && data.breakEnd.size() <= 10 &&
        data.updatedAt is timestamp;
    }

    function isValidPublicBookedSlot(data) {
      return data.keys().hasAll(['staffId', 'date', 'startTime', 'durationMinutes', 'status', 'updatedAt']) &&
        data.keys().hasOnly(['staffId', 'date', 'startTime', 'durationMinutes', 'status', 'updatedAt']) &&
        data.staffId is string && data.staffId.size() >= 1 && data.staffId.size() <= 128 &&
        data.date is string && data.date.size() == 10 &&
        data.startTime is string && data.startTime.size() >= 4 && data.startTime.size() <= 8 &&
        data.durationMinutes is number && data.durationMinutes >= 5 && data.durationMinutes <= 480 &&
        data.status in ['confirmed', 'checked_in', 'in_progress', 'completed', 'cancelled', 'no_show'] &&
        data.updatedAt is timestamp;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, write: if false;
    }

    match /authorizedUsers/{userId} {
      allow get: if isVerified() && isValidId(userId) && (
        isPrimaryAdmin() ||
        request.auth.uid == userId
      );
      allow list: if isPrimaryAdmin() || (isVerified() && resource.data.uid == request.auth.uid);
      allow create: if isPrimaryAdmin() && isValidId(userId) && isValidAuthorizedUser(incoming()) &&
        incoming().uid == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isPrimaryAdmin() && isValidId(userId) && isValidAuthorizedUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdByEmail == existing().createdByEmail &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'role', 'active', 'updatedAt']);
      allow delete: if isPrimaryAdmin() && isValidId(userId);
    }

    match /staffAccess/{accessId} {
      allow get: if isVerified() && isValidId(accessId) && (
        isPrimaryAdmin() ||
        (resource == null && accessId == authEmailDocId()) ||
        (resource != null && request.auth.token.email.lower() == existing().email.lower())
      );
      allow list: if isPrimaryAdmin() || (
        isVerified() && resource.data.email.lower() == request.auth.token.email.lower()
      );
      allow create: if isPrimaryAdmin() && isValidId(accessId) && isValidStaffAccess(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isPrimaryAdmin() && isValidId(accessId) && isValidStaffAccess(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isPrimaryAdmin() && isValidId(accessId);
    }

    match /publicCatalog/{studioId} {
      allow get: if isValidId(studioId);
      allow list: if false;
      allow create, update: if isAuthorizedAccount() && isValidId(studioId) &&
        hasStudioAccess(studioId) &&
        isValidPublicStudio(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if isPrimaryAdmin() && isValidId(studioId);

      match /services/{serviceId} {
        allow get: if isValidId(studioId) && isValidId(serviceId) && (resource == null || existing().active == true || isPrimaryAdmin());
        allow list: if resource.data.active == true || isPrimaryAdmin();
        allow create, update: if isAuthorizedAccount() && isValidId(studioId) && isValidId(serviceId) &&
          hasStudioAccess(studioId) &&
          isValidPublicService(incoming()) &&
          incoming().updatedAt == request.time;
        allow delete: if isAuthorizedAccount() && isValidId(studioId) && isValidId(serviceId) && hasStudioAccess(studioId);
      }

      match /rooms/{roomId} {
        allow get: if isValidId(studioId) && isValidId(roomId) && (resource == null || existing().active == true || isPrimaryAdmin());
        allow list: if resource.data.active == true || isPrimaryAdmin();
        allow create, update: if isAuthorizedAccount() && isValidId(studioId) && isValidId(roomId) &&
