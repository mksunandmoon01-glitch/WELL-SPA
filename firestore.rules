        allow get: if isValidId(studioId) && isValidId(staffId) && (resource == null || existing().onDuty == true || isPrimaryAdmin());
        allow list: if resource.data.onDuty == true || isPrimaryAdmin();
        allow create, update: if isAuthorizedAccount() && isValidId(studioId) && isValidId(staffId) &&
          hasStudioAccess(studioId) &&
          isValidPublicStaff(incoming()) &&
          incoming().updatedAt == request.time;
        allow delete: if isAuthorizedAccount() && isValidId(studioId) && isValidId(staffId) && hasStudioAccess(studioId);
      }

      match /bookedSlots/{slotId} {
        allow get: if isValidId(studioId) && isValidId(slotId) &&
          (resource == null || existing().status in ['confirmed', 'checked_in', 'in_progress'] || isPrimaryAdmin());
        allow list: if resource.data.status in ['confirmed', 'checked_in', 'in_progress'] || isPrimaryAdmin();
        allow create, update: if isAuthorizedAccount() && isValidId(studioId) && isValidId(slotId) &&
          hasStudioAccess(studioId) &&
          isValidPublicBookedSlot(incoming()) &&
          incoming().updatedAt == request.time;
        allow delete: if isAuthorizedAccount() && isValidId(studioId) && isValidId(slotId) && hasStudioAccess(studioId);
      }
    }

    match /studios/{studioId} {
      allow get: if isVerified() && isValidId(studioId) && (
        (resource == null && isPrimaryAdmin()) ||
        (resource != null && hasStudioDocAccess(existing()))
      );
      allow list: if isVerified() && hasStudioDocAccess(resource.data);
      allow create: if isPrimaryAdmin() && isValidId(studioId) && isValidStudio(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAuthorizedAccount() && isValidId(studioId) && isValidStudio(incoming()) &&
        hasStudioDocAccess(existing()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isPrimaryAdmin() ||
          (
            incoming().memberUids == existing().memberUids &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'venueName', 'tagline', 'timezone', 'currency', 'address', 'phone',
              'contactEmail', 'telegramContacts', 'telegramChannel', 'seeded', 'updatedAt'
            ])
          )
        );
      allow delete: if isPrimaryAdmin() && isValidId(studioId);

      match /rooms/{roomId} {
        allow get: if isVerified() && isValidId(studioId) && isValidId(roomId) && (
          (resource == null && hasStudioAccess(studioId)) ||
          (resource != null && hasStudioDocAccess(existing()))
        );
        allow list: if isVerified() && hasStudioDocAccess(resource.data);
        allow create: if isAuthorizedAccount() && isValidId(studioId) && isValidId(roomId) && isValidRoom(incoming()) &&
          hasStudioAccess(studioId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isAuthorizedAccount() && isValidId(studioId) && isValidId(roomId) && isValidRoom(incoming()) &&
          hasStudioDocAccess(existing()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isPrimaryAdmin() ||
            (
              incoming().memberUids == existing().memberUids &&
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'roomType', 'active', 'notes', 'updatedAt'])
            )
