        );
        allow list: if isVerified() && hasStudioDocAccess(resource.data);
        allow create: if isAuthorizedAccount() && isValidId(studioId) && isValidId(staffId) && isValidStaff(incoming()) &&
          hasStudioAccess(studioId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isAuthorizedAccount() && isValidId(studioId) && isValidId(staffId) && isValidStaff(incoming()) &&
          hasStudioDocAccess(existing()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isPrimaryAdmin() ||
            (
              incoming().memberUids == existing().memberUids &&
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['onDuty', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['workDays', 'shiftStart', 'shiftEnd', 'breakStart', 'breakEnd', 'assignedRoomId', 'assignedRoom', 'onDuty', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'specialty', 'bio', 'avatarUrl', 'assignedRoomId', 'assignedRoom', 'onDuty', 'workDays', 'shiftStart', 'shiftEnd', 'breakStart', 'breakEnd', 'updatedAt'])
              )
            )
          );
        allow delete: if isAuthorizedAccount() && isValidId(studioId) && isValidId(staffId) && hasStudioDocAccess(existing());
      }

      match /membershipTiers/{tierId} {
        allow get: if isVerified() && isValidId(studioId) && isValidId(tierId) && (
          (resource == null && hasStudioAccess(studioId)) ||
          (resource != null && hasStudioDocAccess(existing()))
        );
        allow list: if isVerified() && hasStudioDocAccess(resource.data);
        allow create: if isAuthorizedAccount() && isValidId(studioId) && isValidId(tierId) && isValidMembershipTier(incoming()) &&
          hasStudioAccess(studioId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isAuthorizedAccount() && isValidId(studioId) && isValidId(tierId) && isValidMembershipTier(incoming()) &&
          hasStudioDocAccess(existing()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isPrimaryAdmin() ||
            (
              incoming().memberUids == existing().memberUids &&
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'targetAudience', 'monthlyPrice', 'creditsPerMonth', 'retailDiscountPercent', 'priorityWindowHours', 'perksSummary', 'active', 'updatedAt'])
            )
          );
        allow delete: if isAuthorizedAccount() && isValidId(studioId) && isValidId(tierId) && hasStudioDocAccess(existing());
      }

      match /clients/{clientId} {
        allow get: if isVerified() && isValidId(studioId) && isValidId(clientId) && (
          (resource == null && hasStudioAccess(studioId)) ||
          (resource != null && hasStudioDocAccess(existing()))
        );
        allow list: if isVerified() && hasStudioDocAccess(resource.data);
        allow create: if isAuthorizedAccount() && isValidId(studioId) && isValidId(clientId) && isValidClient(incoming()) &&
          hasStudioAccess(studioId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isAuthorizedAccount() && isValidId(studioId) && isValidId(clientId) && isValidClient(incoming()) &&
          hasStudioDocAccess(existing()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isPrimaryAdmin() ||
            (
              incoming().memberUids == existing().memberUids &&
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['creditsRemaining', 'totalVisits', 'lifetimeSpend', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['membershipTierId', 'membershipTierName', 'membershipStatus', 'creditsRemaining', 'nextRenewalDate', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'email', 'phone', 'notes', 'preferredTherapistId', 'smsOptIn', 'emailOptIn', 'updatedAt'])
              )
            )
          );
        allow delete: if isAuthorizedAccount() && isValidId(studioId) && isValidId(clientId) && hasStudioDocAccess(existing());
      }

      match /appointments/{appointmentId} {
        allow get: if isVerified() && isValidId(studioId) && isValidId(appointmentId) && (
          (resource == null && hasStudioAccess(studioId)) ||
          (resource != null && hasStudioDocAccess(existing()))
        );
        allow list: if isVerified() && hasStudioDocAccess(resource.data);
        allow create: if isAuthorizedAccount() && isValidId(studioId) && isValidId(appointmentId) && isValidAppointment(incoming()) &&
          hasStudioAccess(studioId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isAuthorizedAccount() && isValidId(studioId) && isValidId(appointmentId) && isValidAppointment(incoming()) &&
          hasStudioDocAccess(existing()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isPrimaryAdmin() ||
            (
              incoming().memberUids == existing().memberUids &&
              !(existing().status in ['completed', 'cancelled', 'no_show']) &&
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['confirmationSent', 'reminderSent', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['staffId', 'staffName', 'roomName', 'date', 'startTime', 'notes', 'updatedAt'])
              )
            )
          );
        allow delete: if isAuthorizedAccount() && isValidId(studioId) && isValidId(appointmentId) && hasStudioDocAccess(existing());
      }

      match /notificationRules/{ruleId} {
        allow get: if isVerified() && isValidId(studioId) && isValidId(ruleId) && (
          (resource == null && hasStudioAccess(studioId)) ||
          (resource != null && hasStudioDocAccess(existing()))
        );
        allow list: if isVerified() && hasStudioDocAccess(resource.data);
        allow create: if isAuthorizedAccount() && isValidId(studioId) && isValidId(ruleId) && isValidNotificationRule(incoming()) &&
          hasStudioAccess(studioId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isAuthorizedAccount() && isValidId(studioId) && isValidId(ruleId) && isValidNotificationRule(incoming()) &&
          hasStudioDocAccess(existing()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isPrimaryAdmin() ||
            (
              incoming().memberUids == existing().memberUids &&
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['enabled', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['sentCount', 'updatedAt']) ||
                incoming().diff(existing()).affectedKeys().hasOnly(['channel', 'timingLabel', 'enabled', 'subjectTemplate', 'bodyTemplate', 'updatedAt'])
              )
            )
          );
        allow delete: if isAuthorizedAccount() && isValidId(studioId) && isValidId(ruleId) && hasStudioDocAccess(existing());
      }

      match /notificationLogs/{logId} {
        allow get: if isVerified() && isValidId(studioId) && isValidId(logId) && (
          (resource == null && hasStudioAccess(studioId)) ||
          (resource != null && hasStudioDocAccess(existing()))
        );
        allow list: if isVerified() && hasStudioDocAccess(resource.data);
        allow create: if isAuthorizedAccount() && isValidId(studioId) && isValidId(logId) && isValidNotificationLog(incoming()) &&
          hasStudioAccess(studioId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isAuthorizedAccount() && isValidId(studioId) && isValidId(logId) && isValidNotificationLog(incoming()) &&
          hasStudioDocAccess(existing()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isPrimaryAdmin() ||
            (
              incoming().memberUids == existing().memberUids &&
              existing().status == 'scheduled' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'sentAtLabel', 'updatedAt'])
            )
          );
        allow delete: if isAuthorizedAccount() && isValidId(studioId) && isValidId(logId) && hasStudioDocAccess(existing());
      }

      match /creditDeductions/{deductionId} {
        allow get: if isVerified() && isValidId(studioId) && isValidId(deductionId) && (
          (resource == null && hasStudioAccess(studioId)) ||
          (resource != null && hasStudioDocAccess(existing()))
        );
        allow list: if isVerified() && hasStudioDocAccess(resource.data);
        allow create: if isAuthorizedAccount() && isValidId(studioId) && isValidId(deductionId) && isValidCreditDeduction(incoming()) &&
          hasStudioAccess(studioId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isPrimaryAdmin() && isValidId(studioId) && isValidId(deductionId) && isValidCreditDeduction(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time;
        allow delete: if isAuthorizedAccount() && isValidId(studioId) && isValidId(deductionId) && hasStudioDocAccess(existing());
      }
    }
  }
}
