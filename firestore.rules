      match /services/{serviceId} {
        allow get: if isVerified() && isValidId(studioId) && isValidId(serviceId) && (
          (resource == null && hasStudioAccess(studioId)) ||
          (resource != null && hasStudioDocAccess(existing()))
        );
        allow list: if isVerified() && hasStudioDocAccess(resource.data);
        allow create: if isAuthorizedAccount() && isValidId(studioId) && isValidId(serviceId) && isValidService(incoming()) &&
          hasStudioAccess(studioId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isAuthorizedAccount() && isValidId(studioId) && isValidId(serviceId) && isValidService(incoming()) &&
          hasStudioDocAccess(existing()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            isPrimaryAdmin() ||
            (
              incoming().memberUids == existing().memberUids &&
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'durationMinutes', 'bufferMinutes', 'price', 'roomType', 'description', 'active', 'updatedAt'])
            )
